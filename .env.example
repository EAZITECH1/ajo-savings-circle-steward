# ==========================================
# Ajo Savings Circle Steward Configuration
# ==========================================
# Safe template. Copy to .env and fill in real values.
# NEVER commit .env to version control.

# --- Express + Vite Web Server ---
PORT=3000

# --- Tatum Sui Gateway Integration ---
# Required for on-chain contribution verification
TATUM_API_KEY=your_tatum_api_key_here
TATUM_API_BASE=https://api.tatum.io
SUI_NETWORK=testnet
SUI_TOKEN_TYPE=0x2::sui::SUI
SUI_TOKEN_DECIMALS=9

# --- Move Smart Contract Package (Sui Testnet) ---
# Published package ID containing module ajo::circle
AJO_PACKAGE_ID=0x0d7dfa83d83c9187781a8acb0af9f7797bce6c157e417503fa18c04f03238466

# --- Walrus Memory Integration (@mysten-incubation/memwal) ---
# Operates on Walrus Mainnet. Requires registered delegate key and Sui MemWalAccount object ID.
MEMWAL_KEY=your_ed25519_delegate_private_key_here
MEMWAL_ACCOUNT_ID=0xf6b75c6fd44e685829e0baa04077c42c09bed658819e921126dc11ce8c3175d4
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=ajo-circle

# --- Advisory AI Steward (LLM) ---
# Compatible with any OpenAI-compatible chat completions endpoint (e.g. OpenRouter, OpenAI)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# --- Tunables, Grace Policies & RPC Rate Limits (Optional, Defaults shown) ---
GRACE_WINDOW_HOURS=72
PARTIAL_PAYMENT_WINDOW_HOURS=48
POLLING_INTERVAL_MS=1500
RATE_LIMIT_RPS=3
RATE_LIMIT_MAX_RETRIES=3
RATE_LIMIT_BACKOFF_MS=1000
RECALL_LIMIT=10
REQUEST_TIMEOUT_MS=20000
